---
import BrandSymbol from './BrandSymbol.astro';

const contactEmail = 'info@shinerva.com';
---

<footer id="contact" class="bg-[var(--night)] text-[#F7F2EC] pt-24 sm:pt-32 pb-16 px-6 sm:px-12 lg:px-20 border-t border-white/10 overflow-hidden">
  <div class="max-w-7xl mx-auto flex flex-col gap-20 sm:gap-28">
    <!-- Contact CTA -->
    <div data-fade-up class="flex flex-col items-start gap-6 max-w-3xl">
      <span class="text-[12px] sm:text-[13px] font-bold tracking-[0.2em] uppercase text-[var(--terracotta-text-night)]">
        Have an idea, product, or partnership?
      </span>

      <h2 class="text-[42px] sm:text-[60px] md:text-[76px] font-extrabold leading-[0.98] tracking-[-0.04em] text-[#F7F2EC] text-balance">
        Let's build what comes next.
      </h2>

      <p class="text-[17px] sm:text-[19px] text-[#F7F2EC]/80 leading-relaxed font-normal max-w-xl">
        Shinerva collaborates with forward-thinking operators, founders, and partners across technology and digital ecosystems.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <a
          href={`mailto:${contactEmail}`}
          class="group inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-[var(--terracotta-btn)] text-white text-[15px] font-bold tracking-tight shadow-lg hover:bg-[var(--terracotta-deep)] active:scale-[0.98] transition-all duration-200 focus-visible:outline-none"
        >
          <span>Get in touch</span>
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3.333 8h9.334" />
            <path d="M8.667 4l4 4-4 4" />
          </svg>
        </a>

        <span class="text-[14px] font-mono text-[#F7F2EC]/60 sm:pl-2">
          {contactEmail}
        </span>
      </div>
    </div>

    <!-- ONE Giant Outlined SHINERVA Wordmark (1.5px Terracotta stroke, no fill, static) -->
    <div class="w-full py-4 select-none" aria-hidden="true">
      <svg
        viewBox="0 0 1000 130"
        class="w-full h-auto block overflow-visible"
        preserveAspectRatio="xMidYMid meet"
      >
        <text
          x="50%"
          y="78%"
          text-anchor="middle"
          fill="none"
          stroke="var(--terracotta)"
          stroke-width="1.5"
          font-family="'Plus Jakarta Sans Variable', -apple-system, sans-serif"
          font-weight="800"
          font-size="124"
          letter-spacing="0.04em"
        >
          SHINERVA
        </text>
      </svg>
    </div>

    <!-- Footer Row -->
    <div class="pt-10 border-t border-white/10 flex flex-col gap-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <!-- Logo -->
        <a href="#home" class="inline-flex items-center gap-2.5 text-[#F7F2EC] focus-visible:outline-none">
          <div class="w-7 h-7 rounded-lg bg-[var(--canvas)] text-[var(--ink)] flex items-center justify-center">
            <BrandSymbol size={22} class="text-[var(--ink)]" />
          </div>
          <span class="font-bold tracking-[0.08em] text-[13px] uppercase text-[#F7F2EC]">
            Shinerva
          </span>
        </a>

        <!-- Ecosystem Links -->
        <div class="flex flex-wrap items-center gap-6 sm:gap-8 text-[14px] font-medium text-[#F7F2EC]/80">
          <a href="https://shinerva.id" target="_blank" rel="noopener" class="hover:text-white transition-colors">
            Shinerva.id
          </a>
          <a href="https://tikum.app" target="_blank" rel="noopener" class="hover:text-white transition-colors">
            Tikum
          </a>
          <a href="https://salmo.dev" target="_blank" rel="noopener" class="hover:text-white transition-colors">
            Salmo
          </a>
          <a href={`mailto:${contactEmail}`} class="hover:text-white transition-colors">
            Email
          </a>
        </div>
      </div>

      <!-- Copyright -->
      <div class="text-[12px] text-[#F7F2EC]/50 tracking-tight">
        © 2026 Shinerva. All rights reserved.
      </div>
    </div>
  </div>
</footer>
