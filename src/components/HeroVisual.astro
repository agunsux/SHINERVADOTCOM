---
---

<div class="relative w-[200px] sm:w-[260px] md:w-[320px] lg:w-full max-w-[420px] xl:max-w-[480px] aspect-square flex items-center justify-center select-none" aria-hidden="true">
  <!-- Subtle Ambient Light for Cream Depth -->
  <div class="absolute inset-0 rounded-full bg-white/[0.04] blur-3xl pointer-events-none"></div>

  <!-- Geometric Interconnected Ring Structure (Cream hairlines at 25-35% opacity) -->
  <div class="relative w-full h-full flex items-center justify-center">
    <svg
      viewBox="0 0 400 400"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full hero-orbit-spin text-[#F7F2EC]"
    >
      <!-- Outer Harmonic Boundary Ring -->
      <circle
        cx="200"
        cy="200"
        r="180"
        stroke="currentColor"
        stroke-opacity="0.25"
        stroke-width="1.2"
        stroke-dasharray="4 8"
      />

      <!-- Secondary Ecosystem Orbit -->
      <circle
        cx="200"
        cy="200"
        r="135"
        stroke="currentColor"
        stroke-opacity="0.32"
        stroke-width="1.2"
      />

      <!-- Inner Foundation Orbit -->
      <circle
        cx="200"
        cy="200"
        r="90"
        stroke="currentColor"
        stroke-opacity="0.28"
        stroke-width="1.2"
        stroke-dasharray="2 6"
      />

      <!-- Subtle Geometric Axis Indicators -->
      <line
        x1="200"
        y1="15"
        x2="200"
        y2="385"
        stroke="currentColor"
        stroke-opacity="0.18"
        stroke-width="1"
      />
      <line
        x1="15"
        y1="200"
        x2="385"
        y2="200"
        stroke="currentColor"
        stroke-opacity="0.18"
        stroke-width="1"
      />

      <!-- Three Ecosystem Focal Nodes -->
      <!-- Node 1: North-East (AI & Creative Technology) -->
      <g transform="translate(295, 105)">
        <circle cx="0" cy="0" r="5" fill="currentColor" fill-opacity="0.8" />
        <circle cx="0" cy="0" r="2" fill="var(--terracotta-deep)" />
      </g>

      <!-- Node 2: South-East (Digital Marketplace) -->
      <g transform="translate(295, 295)">
        <circle cx="0" cy="0" r="5" fill="currentColor" fill-opacity="0.8" />
        <circle cx="0" cy="0" r="2" fill="var(--terracotta-deep)" />
      </g>

      <!-- Node 3: West (Sports Data & Intelligence) -->
      <g transform="translate(65, 200)">
        <circle cx="0" cy="0" r="5" fill="currentColor" fill-opacity="0.8" />
        <circle cx="0" cy="0" r="2" fill="var(--terracotta-deep)" />
      </g>

      <!-- Connection vectors indicating ecosystem exchange -->
      <path
        d="M 295 105 C 260 160 220 180 200 200"
        stroke="currentColor"
        stroke-opacity="0.25"
        stroke-width="1.2"
      />
      <path
        d="M 295 295 C 260 240 220 220 200 200"
        stroke="currentColor"
        stroke-opacity="0.25"
        stroke-width="1.2"
      />
      <path
        d="M 65 200 C 120 200 160 200 200 200"
        stroke="currentColor"
        stroke-opacity="0.25"
        stroke-width="1.2"
      />
    </svg>

    <!-- Center Gravitas: Master Shinerva Monogram in Cream/Terracotta Tint -->
    <div
      class="hero-center-breathe absolute w-14 h-14 sm:w-20 sm:h-20 md:w-24 md:h-24 lg:w-28 lg:h-28 rounded-2xl sm:rounded-3xl bg-[#F7F2EC]/15 backdrop-blur-md border border-[#F7F2EC]/30 shadow-[0_12px_40px_rgba(0,0,0,0.18)] flex items-center justify-center p-3.5 sm:p-5 lg:p-6"
    >
      <svg
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-full text-[#F7F2EC]"
      >
        <path
          d="M10 12C10 7.58 13.58 4.5 18 4.5H20C24.42 4.5 27.5 7.58 27.5 12C27.5 16.42 24.42 19 20 19H15"
          stroke="currentColor"
          stroke-width="2.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M22 20C22 24.42 18.42 27.5 14 27.5H12C7.58 27.5 4.5 24.42 4.5 20C4.5 15.58 7.58 13 12 13H17"
          stroke="currentColor"
          stroke-width="2.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>
</div>
