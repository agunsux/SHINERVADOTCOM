---
interface Props {
  index?: number;
  name: string;
  tagline: string;
  descriptor: string;
  body: string;
  url: string;
  ctaText: string;
  ariaLabel?: string;
}

const { index = 0, name, tagline, descriptor, body, url, ctaText } = Astro.props;
const staggerDelay = index * 80;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  data-fade-up
  style={`transition-delay: ${staggerDelay}ms;`}
  class="group relative flex flex-col justify-between h-full p-8 rounded-[24px] bg-[var(--canvas)] border border-[var(--line)] hover:border-[var(--terracotta)]/40 hover:-translate-y-1 transition-all duration-250 ease-out focus-visible:outline-none"
>
  <!-- Card Content -->
  <div class="flex flex-col gap-6">
    <!-- 1. Small Name -->
    <span class="text-[13px] font-semibold text-[var(--ink-soft)] tracking-wider uppercase">
      {name}
    </span>

    <!-- 2. Tagline (Dominant, 28-32px, weight 800) -->
    <h3 class="text-[28px] sm:text-[32px] font-extrabold text-[var(--ink)] leading-[1.05] tracking-[-0.035em]">
      {tagline}
    </h3>

    <!-- 3. Descriptor Label (Small caps, --terracotta-text) -->
    <span class="text-[11px] sm:text-[12px] font-bold tracking-[0.16em] uppercase text-[var(--terracotta-text)]">
      {descriptor}
    </span>

    <!-- 4. Body Copy -->
    <p class="text-[15px] sm:text-[16px] text-[var(--ink-soft)] leading-relaxed font-normal">
      {body}
    </p>
  </div>

  <!-- 5. Arrow Link (Arrow moves 6px on hover) -->
  <div class="pt-8 flex items-center gap-2 text-[14px] font-bold text-[var(--ink)] group-hover:text-[var(--terracotta-text)] transition-colors">
    <span>{ctaText}</span>
    <svg
      class="w-4 h-4 transition-transform duration-250 ease-out group-hover:translate-x-[6px]"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3.333 8h9.334" />
      <path d="M8.667 4l4 4-4 4" />
    </svg>
  </div>
</a>
