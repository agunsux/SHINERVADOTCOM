---
import FloatingNav from '../components/FloatingNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Shinerva - Building Digital Ecosystems',
  description = 'Shinerva builds and grows technology businesses across AI, software, and data.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://shinerva.com');
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light dark" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Shinerva" />
    <meta property="og:image" content="https://shinerva.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shinerva — Building Digital Ecosystems" />

    <!-- Twitter / X Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://shinerva.com/og-image.png" />
    <meta name="twitter:image:alt" content="Shinerva — Building Digital Ecosystems" />

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data (JSON-LD Organization & Ecosystem Hierarchy) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Shinerva",
        "url": "https://shinerva.com",
        "logo": "https://shinerva.com/favicon.svg",
        "description": "Shinerva builds and grows technology businesses across AI, software, and data.",
        "subOrganization": [
          {
            "@type": "Organization",
            "name": "Shinerva.id",
            "url": "https://shinerva.id",
            "description": "Natural Indonesian AI voice for creators, educators, and businesses."
          },
          {
            "@type": "Organization",
            "name": "Tikum",
            "url": "https://tikum.app",
            "description": "A consumer brand built around useful products and everyday technology."
          },
          {
            "@type": "Organization",
            "name": "Salmo",
            "url": "https://salmo.dev",
            "description": "Football research and data turned into better decisions. Built on the HandicapLab foundation."
          }
        ]
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink)] antialiased">
    <!-- Floating Pill Navigation (Centered, Fixed) -->
    <FloatingNav />

    <!-- Main Content Flow -->
    <main class="w-full">
      <slot />
    </main>

    <!-- Scroll Animations IntersectionObserver (600ms/800ms, once) -->
    <script>
      const setupScrollAnimations = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        const fadeTargets = document.querySelectorAll('[data-fade-up]');
        const wordmarkTargets = document.querySelectorAll('[data-fade-wordmark]');

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (entry.target.hasAttribute('data-fade-wordmark')) {
                  entry.target.classList.add('wordmark-reveal-visible');
                  entry.target.classList.remove('wordmark-reveal-init');
                } else {
                  entry.target.classList.add('fade-up-visible');
                  entry.target.classList.remove('fade-up-init');
                }
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.02, rootMargin: '0px 0px 100px 0px' }
        );

        fadeTargets.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            el.classList.add('fade-up-visible');
          } else {
            el.classList.add('fade-up-init');
            observer.observe(el);
          }
        });

        wordmarkTargets.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            el.classList.add('wordmark-reveal-visible');
          } else {
            el.classList.add('wordmark-reveal-init');
            observer.observe(el);
          }
        });

        // Fail-safe to guarantee content is never permanently hidden
        setTimeout(() => {
          fadeTargets.forEach((el) => {
            el.classList.add('fade-up-visible');
            el.classList.remove('fade-up-init');
          });
          wordmarkTargets.forEach((el) => {
            el.classList.add('wordmark-reveal-visible');
            el.classList.remove('wordmark-reveal-init');
          });
        }, 1500);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollAnimations);
      } else {
        setupScrollAnimations();
      }
    </script>
  </body>
</html>
